        "        ],\n",
        "        duplicates='drop' # Handle cases where quantile bins might be identical\n",
        "    ).astype(str) + ' (Avg: ' + batters_df['average'].round(2).astype(str) + ')' # Add actual average\n",
        "\n",
        "print(\"Batters Ranking and Classification (Quantile-based):\")\n",
        "display(batters_df[['average', 'strike_rate', 'innings', 'hundreds', 'fifties',\n",
        "                    'avg_rank', 'sr_rank', 'innings_rank', 'hundreds_rank', 'fifties_rank',\n",
        "                    'Runs_Class']].sort_values(by='avg_rank').head(10))\n"
