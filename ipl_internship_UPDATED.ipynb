      "source": [
        "import pandas as pd\n",
        "\n",
        "# Load the IPL dataset to inspect the year column (skipping corrupted rows)\n",
        "df_check_years = pd.read_csv('/content/ipl.csv', on_bad_lines='skip', low_memory=False)\n",
        "# df_check_years = pd.read_csv('/content/IPL.csv', on_bad_lines='skip', low_memory=False)\n",
        "\n",
        "# Get the unique years and their min/max values\n",
        "unique_years = sorted(df_check_years['year'].unique())\n",
        "min_year = min(unique_years)\n",
        "max_year = max(unique_years)\n",
        "\n",
        "print(f\"Years present in the dataset: {unique_years}\")\n",
        "print(f\"Minimum year: {min_year}\")\n",
        "print(f\"Maximum year: {max_year}\")"
      ],
