      "source": [
        "import pandas as pd\n",
        "\n",
        "OUTPUT_ALL_RECORDS = \"players_2008_to_2025_records.csv\"\n",
        "OUTPUT_PLAYER_LIST = \"players_2008_to_2025_list.csv\"\n",
        "START_YEAR = 2012\n",
        "END_YEAR = 2025\n",
        "\n",
        "def main():\n",
        "    possible_input_files = [\"/content/IPL.csv\", \"/content/ipl.csv\"]\n",
        "    df = None\n",
        "    loaded_file = None\n",
        "\n",
        "    for fname in possible_input_files:\n",
        "        try:\n",
        "            print(f\"Attempting to read {fname} ...\")\n",
        "            # Added on_bad_lines='skip' to bypass broken lines and low_memory=False\n",
        "            df = pd.read_csv(fname, on_bad_lines='skip', low_memory=False)\n",
        "            loaded_file = fname\n",
        "            break\n",
        "        except FileNotFoundError:\n",
        "            print(f\"File not found: {fname}. Trying next option...\")\n",
        "            continue\n",
        "        except Exception as e:\n",
        "            print(f\"An unexpected error occurred while reading {fname}: {e}\")\n",
        "            continue\n",
        "\n",
        "    if df is None:\n",
        "        raise FileNotFoundError(f\"Could not load any valid dataset from: {possible_input_files}\")\n",
        "\n",
        "    print(f\"Successfully read data from {loaded_file}.\")\n",
        "\n",
        "    required_years = set(range(START_YEAR, END_YEAR + 1))\n",
        "\n",
        "    role_cols = [\"batter\", \"bowler\", \"non_striker\"]\n",
        "    frames = []\n",
        "    for col in role_cols:\n",
        "        temp = df[[col, \"year\"]].rename(columns={col: \"player\"})\n",
        "        frames.append(temp)\n",
        "\n",
        "    appearances = pd.concat(frames, ignore_index=True).dropna(subset=[\"player\"])\n",
        "    years_by_player = appearances.drop_duplicates().groupby(\"player\")[\"year\"].apply(set)\n",
        "\n",
        "    qualifying_players = sorted(\n",
        "        player for player, years in years_by_player.items()\n",
        "        if required_years.issubset(years)\n",
        "    )\n",
        "\n",
        "    print(f\"Found {len(qualifying_players)} player(s) who played in every season from {START_YEAR} to {END_YEAR}:\")\n",
        "    for p in qualifying_players:\n",
        "        print(f\"  - {p}\")\n",
        "\n",
        "    pd.DataFrame({\"player\": qualifying_players}).to_csv(OUTPUT_PLAYER_LIST, index=False)\n",
        "    print(f\"\\nSaved player list to {OUTPUT_PLAYER_LIST}\")\n",
        "\n",
        "    mask = (\n",
        "        df[\"batter\"].isin(qualifying_players)\n",
        "        | df[\"bowler\"].isin(qualifying_players)\n",
        "        | df[\"non_striker\"].isin(qualifying_players)\n",
        "    )\n",
        "    records = df[mask]\n",
        "    records.to_csv(OUTPUT_ALL_RECORDS, index=False)\n",
        "    print(f\"Saved {len(records)} matching records to {OUTPUT_ALL_RECORDS}\")\n",
        "\n",
        "if __name__ == \"__main__\":\n",
        "    main()"
      ]
    },
