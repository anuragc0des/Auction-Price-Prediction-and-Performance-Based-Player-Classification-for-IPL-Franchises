    {
      "cell_type": "markdown",
      "metadata": {
        "id": "cb18b52c"
      },
      "source": [
        "### Player Pairwise Comparison Heat Matrices\n",
        "\n",
        "To construct these matrices, we will compute the metric difference between every pair of players (e.g., $Player_{Row} - Player_{Column}$). For batting metrics, a positive value indicates the row player outperformed the column player. For bowling metrics (where lower values are better), we invert the difference so that a positive value still indicates that the row player performed better (lower average/economy) than the column player."
      ]
    },
    {
      "cell_type": "code",
      "metadata": {
        "id": "4a01031d",
        "outputId": "0303ff35-2e08-4347-9f46-7f0e1e5b26d6",
        "colab": {
          "base_uri": "https://localhost:8080/",
          "height": 456
        }
      },
      "source": [
        "import matplotlib.pyplot as plt\n",
        "import seaborn as sns\n",
        "import pandas as pd\n",
        "import numpy as np\n",
        "\n",
        "# --- Batter Comparison Heatmaps ---\n",
        "batter_players = batters_df.index.tolist()\n",
        "batter_averages = batters_df['average']\n",
        "batter_strike_rates = batters_df['strike_rate']\n",
        "\n",
        "# 1. Batting Average Difference Matrix\n",
        "batter_avg_diff = pd.DataFrame(index=batter_players, columns=batter_players, dtype=float)\n",
        "for p1 in batter_players:\n",
        "    for p2 in batter_players:\n",
        "        batter_avg_diff.loc[p1, p2] = batter_averages.loc[p1] - batter_averages.loc[p2]\n",
        "\n",
        "# 2. Batting Strike Rate Difference Matrix\n",
        "batter_sr_diff = pd.DataFrame(index=batter_players, columns=batter_players, dtype=float)\n",
        "for p1 in batter_players:\n",
        "    for p2 in batter_players:\n",
        "        batter_sr_diff.loc[p1, p2] = batter_strike_rates.loc[p1] - batter_strike_rates.loc[p2]\n",
        "\n",
        "# Plotting Batting Heatmaps\n",
        "fig, axes = plt.subplots(1, 2, figsize=(20, 8))\n",
        "sns.heatmap(batter_avg_diff, annot=True, fmt=\".1f\", cmap=\"RdYlGn\", center=0, ax=axes[0], cbar_kws={'label': 'Difference in Average'})\n",
        "axes[0].set_title(\"Batting Average Comparison (Row - Col)\")\n",
        "axes[0].set_xlabel(\"Compared Against\")\n",
        "axes[0].set_ylabel(\"Player\")\n",
        "\n",
        "sns.heatmap(batter_sr_diff, annot=True, fmt=\".1f\", cmap=\"RdYlGn\", center=0, ax=axes[1], cbar_kws={'label': 'Difference in Strike Rate'})\n",
        "axes[1].set_title(\"Batting Strike Rate Comparison (Row - Col)\")\n",
        "axes[1].set_xlabel(\"Compared Against\")\n",
        "axes[1].set_ylabel(\"\")\n",
        "\n",
        "plt.tight_layout()\n",
        "plt.show()"
      ],
      "execution_count": null,
      "outputs": [
        {
          "output_type": "display_data",
          "data": {
            "text/plain": [
              "<Figure size 2000x800 with 4 Axes>"
            ],
            "image/png": "\n"
          },
          "metadata": {}
        }
      ]
    },
    {
      "cell_type": "code",
      "metadata": {
        "id": "d5e13765",
        "outputId": "58e007d6-dbc0-4d42-f1f3-9b601a135344",
        "colab": {
          "base_uri": "https://localhost:8080/",
          "height": 443
        }
      },
      "source": [
        "# --- Bowler Comparison Heatmaps ---\n",
        "bowler_players = bowlers_df.index.tolist()\n",
        "bowler_averages = bowlers_df['bowl_average']\n",
        "bowler_economies = bowlers_df['economy']\n",
        "\n",
        "# 1. Bowling Average Difference Matrix (Lower is better, so Column - Row)\n",
        "bowler_avg_diff = pd.DataFrame(index=bowler_players, columns=bowler_players, dtype=float)\n",
        "for p1 in bowler_players:\n",
        "    for p2 in bowler_players:\n",
        "        bowler_avg_diff.loc[p1, p2] = bowler_averages.loc[p2] - bowler_averages.loc[p1]\n",
        "\n",
        "# 2. Economy Rate Difference Matrix (Lower is better, so Column - Row)\n",
        "bowler_econ_diff = pd.DataFrame(index=bowler_players, columns=bowler_players, dtype=float)\n",
        "for p1 in bowler_players:\n",
        "    for p2 in bowler_players:\n",
        "        bowler_econ_diff.loc[p1, p2] = bowler_economies.loc[p2] - bowler_economies.loc[p1]\n",
        "\n",
        "# Plotting Bowling Heatmaps\n",
        "fig, axes = plt.subplots(1, 2, figsize=(18, 7))\n",
        "sns.heatmap(bowler_avg_diff, annot=True, fmt=\".2f\", cmap=\"RdYlGn\", center=0, ax=axes[0], cbar_kws={'label': 'Advantage in Bowling Average'})\n",
        "axes[0].set_title(\"Bowling Average Comparison (Col - Row)\")\n",
        "axes[0].set_xlabel(\"Compared Against\")\n",
        "axes[0].set_ylabel(\"Player\")\n",
        "\n",
        "sns.heatmap(bowler_econ_diff, annot=True, fmt=\".2f\", cmap=\"RdYlGn\", center=0, ax=axes[1], cbar_kws={'label': 'Advantage in Economy Rate'})\n",
        "axes[1].set_title(\"Economy Rate Comparison (Col - Row)\")\n",
        "axes[1].set_xlabel(\"Compared Against\")\n",
        "axes[1].set_ylabel(\"\")\n",
        "\n",
        "plt.tight_layout()\n",
        "plt.show()"
      ],
