      "cell_type": "code",
      "source": [
        "import matplotlib.pyplot as plt\n",
        "import seaborn as sns\n",
        "import pandas as pd # Ensure pandas is imported for performance_df if not already globally available\n",
        "\n",
        "# Load the player performance matrix if it's not already in scope\n",
        "# This assumes player_performance_matrix.csv is available from previous steps.\n",
        "# If this cell runs independently, performance_df needs to be loaded.\n",
        "# For the current context, it's already loaded by previous cells 8e6a95c2 and 0d2b5b2f\n",
        "performance_df = pd.read_csv('player_performance_matrix.csv').set_index('player')\n",
        "\n",
        "# Create a figure and axes for the table\n",
        "fig, ax = plt.subplots(figsize=(12, 8))\n",
        "ax.axis('off')\n",
        "\n",
        "# Assuming performance_df is already defined and contains the necessary data\n",
        "# Select relevant columns for the table\n",
        "table_data = performance_df[[\n",
        "    'innings', 'runs', 'average', 'strike_rate',\n",
        "    'wickets', 'economy'\n",
        "]].copy()\n",
        "\n",
        "table = ax.table(\n",
        "    cellText=table_data.values,\n",
        "    colLabels=table_data.columns,\n",
        "    rowLabels=table_data.index,\n",
        "    loc='center',\n",
        "    cellLoc='center',\n",
        "    colLoc='center'\n",
        ")\n",
        "\n",
        "table.auto_set_font_size(False)\n",
        "table.set_fontsize(9) # Corrected method name\n",
        "table.scale(1.2, 1.3)\n",
        "\n",
        "plt.title('Player Key Performance Indicators')\n",
        "plt.show()\n"
      ],
