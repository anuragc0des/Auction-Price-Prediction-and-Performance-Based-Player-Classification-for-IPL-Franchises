    {
      "cell_type": "code",
      "source": [
        "\"\"\"\n",
        "build_performance_matrix.py\n",
        "\n",
        "Builds a batting + bowling performance matrix for the players who played\n",
        "every IPL season from 2008 to 2025 (output of find_players_2008_2025.py),\n",
        "then ranks them using a composite z-score across chosen metrics.\n",
        "\n",
        "Input : players_2008_to_2025_records.csv\n",
        "Output: player_performance_matrix.csv   (raw + per-metric stats)\n",
        "        player_ranking.csv              (z-scores + composite rank)\n",
        "\"\"\"\n",
        "\n",
        "import numpy as np\n",
        "import pandas as pd\n",
        "\n",
        "INPUT_FILE = \"players_2008_to_2025_records.csv\"\n",
        "PLAYER_LIST_FILE = \"players_2008_to_2025_list.csv\"\n",
        "OUTPUT_MATRIX = \"player_performance_matrix.csv\"\n",
        "OUTPUT_RANKING = \"player_ranking.csv\"\n",
        "\n",
        "\n",
        "def batting_stats(df, player):\n",
        "    bat = df[df[\"batter\"] == player]\n",
        "    if bat.empty:\n",
        "        return {\n",
        "            \"innings\": 0, \"runs\": 0, \"balls_faced\": 0, \"dismissals\": 0,\n",
        "            \"not_outs\": 0, \"average\": 0.0, \"strike_rate\": 0.0,\n",
        "            \"fours\": 0, \"sixes\": 0, \"fifties\": 0, \"hundreds\": 0,\n",
        "        }\n",
        "\n",
        "    # Final runs/balls per innings = max cumulative value per match\n",
        "    per_innings = bat.groupby(\"match_id\").agg(\n",
        "        final_runs=(\"batter_runs\", \"max\"),\n",
        "        final_balls=(\"batter_balls\", \"max\"),\n",
        "    )\n",
        "\n",
        "    innings = len(per_innings)\n",
        "    runs = per_innings[\"final_runs\"].sum()\n",
        "    balls_faced = per_innings[\"final_balls\"].sum()\n",
        "\n",
        "    # Dismissals: rows where this player is recorded as the one out\n",
        "    dismissals = df[df[\"player_out\"] == player][\"match_id\"].nunique()\n",
        "    not_outs = innings - dismissals\n",
        "\n",
        "    average = runs / dismissals if dismissals > 0 else runs  # all-not-out edge case\n",
        "    strike_rate = (runs / balls_faced * 100) if balls_faced > 0 else 0.0\n",
        "\n",
        "    fours = (bat[\"runs_batter\"] == 4).sum()\n",
        "    sixes = (bat[\"runs_batter\"] == 6).sum()\n",
        "    fifties = ((per_innings[\"final_runs\"] >= 50) & (per_innings[\"final_runs\"] < 100)).sum()\n",
        "    hundreds = (per_innings[\"final_runs\"] >= 100).sum()\n",
        "\n",
        "    return {\n",
        "        \"innings\": innings, \"runs\": int(runs), \"balls_faced\": int(balls_faced),\n",
        "        \"dismissals\": int(dismissals), \"not_outs\": int(not_outs),\n",
        "        \"average\": round(average, 2), \"strike_rate\": round(strike_rate, 2),\n",
        "        \"fours\": int(fours), \"sixes\": int(sixes),\n",
        "        \"fifties\": int(fifties), \"hundreds\": int(hundreds),\n",
        "    }\n",
        "\n",
        "\n",
        "def bowling_stats(df, player):\n",
        "    bowl = df[df[\"bowler\"] == player]\n",
        "    if bowl.empty:\n",
        "        return {\n",
        "            \"bowl_innings\": 0, \"balls_bowled\": 0, \"overs\": 0.0,\n",
        "            \"runs_conceded\": 0, \"wickets\": 0, \"economy\": 0.0,\n",
        "            \"bowl_average\": 0.0, \"bowl_strike_rate\": 0.0,\n",
        "        }\n",
        "\n",
        "    per_innings_runs = bowl.groupby(\"match_id\")[\"runs_bowler\"].max()\n",
        "    bowl_innings = len(per_innings_runs)\n",
        "    runs_conceded = per_innings_runs.sum()\n",
        "\n",
        "    balls_bowled = (bowl[\"valid_ball\"] == 1).sum()\n",
        "    overs = balls_bowled / 6\n",
        "    wickets = bowl[\"bowler_wicket\"].sum()\n",
        "\n",
        "    economy = (runs_conceded / overs) if overs > 0 else 0.0\n",
        "    bowl_average = (runs_conceded / wickets) if wickets > 0 else 0.0\n",
        "    bowl_strike_rate = (balls_bowled / wickets) if wickets > 0 else 0.0\n",
        "\n",
        "    return {\n",
        "        \"bowl_innings\": int(bowl_innings), \"balls_bowled\": int(balls_bowled),\n",
        "        \"overs\": round(overs, 1), \"runs_conceded\": int(runs_conceded),\n",
        "        \"wickets\": int(wickets), \"economy\": round(economy, 2),\n",
        "        \"bowl_average\": round(bowl_average, 2),\n",
        "        \"bowl_strike_rate\": round(bowl_strike_rate, 2),\n",
        "    }\n",
        "\n",
        "\n",
        "def main():\n",
        "    print(f\"Reading {INPUT_FILE} ...\")\n",
        "    df = pd.read_csv(INPUT_FILE, low_memory=False)\n",
        "\n",
        "    # IMPORTANT: players_2008_to_2025_records.csv contains full rows for any\n",
        "    # delivery involving a qualifying player as batter/bowler/non-striker.\n",
        "    # That means opposing bowlers/batters on those deliveries also appear as\n",
        "    # values in the batter/bowler columns. We must NOT compute stats for\n",
        "    # every name in the file -- only for the actual qualifying players.\n",
        "    qualifying = pd.read_csv(PLAYER_LIST_FILE)[\"player\"].tolist()\n",
        "    players = sorted(qualifying)\n",
        "\n",
        "    rows = []\n",
        "    for p in players:\n",
        "        b = batting_stats(df, p)\n",
        "        bw = bowling_stats(df, p)\n",
        "        row = {\"player\": p, **b, **bw}\n",
        "        rows.append(row)\n",
        "\n",
        "    matrix = pd.DataFrame(rows).set_index(\"player\")\n",
        "    matrix.to_csv(OUTPUT_MATRIX)\n",
        "    print(f\"\\nPerformance matrix saved to {OUTPUT_MATRIX}\")\n",
        "    print(matrix.to_string())\n",
        "\n",
        "    # ---------- Composite ranking via z-scores ----------\n",
        "    # Metrics where HIGHER is better\n",
        "    positive_metrics = [\"runs\", \"average\", \"strike_rate\", \"fours\", \"sixes\",\n",
        "                         \"fifties\", \"hundreds\", \"wickets\"]\n",
        "    # Metrics where LOWER is better\n",
        "    negative_metrics = [\"economy\", \"bowl_average\", \"bowl_strike_rate\"]\n",
        "\n",
        "    z = pd.DataFrame(index=matrix.index)\n",
        "    for m in positive_metrics:\n",
        "        std = matrix[m].std()\n",
        "        z[f\"z_{m}\"] = 0.0 if std == 0 else (matrix[m] - matrix[m].mean()) / std\n",
        "\n",
        "    for m in negative_metrics:\n",
        "        std = matrix[m].std()\n",
        "        # invert sign since lower is better\n",
        "        z[f\"z_{m}\"] = 0.0 if std == 0 else -(matrix[m] - matrix[m].mean()) / std\n",
        "\n",
        "    # Weighted composite: batting-heavy weighting since all 4 are primarily\n",
        "    # batters here; adjust weights as needed for your analysis\n",
        "    weights = {\n",
        "        \"z_runs\": 0.20, \"z_average\": 0.15, \"z_strike_rate\": 0.15,\n",
        "        \"z_fours\": 0.05, \"z_sixes\": 0.05, \"z_fifties\": 0.10, \"z_hundreds\": 0.10,\n",
        "        \"z_wickets\": 0.10, \"z_economy\": 0.05,\n",
        "        \"z_bowl_average\": 0.025, \"z_bowl_strike_rate\": 0.025,\n",
        "    }\n",
        "    z[\"composite_score\"] = sum(z[col] * w for col, w in weights.items())\n",
        "    z[\"rank\"] = z[\"composite_score\"].rank(ascending=False).astype(int)\n",
        "    z = z.sort_values(\"rank\")\n",
        "\n",
        "    z.to_csv(OUTPUT_RANKING)\n",
        "    print(f\"\\nRanking (composite z-score) saved to {OUTPUT_RANKING}\")\n",
        "    print(z[[\"composite_score\", \"rank\"]].to_string())\n",
        "\n",
        "\n",
        "if __name__ == \"__main__\":\n",
        "    main()"
      ],
