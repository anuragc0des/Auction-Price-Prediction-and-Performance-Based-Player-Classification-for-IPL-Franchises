      "source": [
        "### Batters Ranking and Classification\n",
        "\n",
        "First, I'll load the player performance data and focus on players who have batted. Then, I'll rank them by Average, Strike Rate, Innings, Centuries, and Fifties. Finally, I'll categorize them into 'Runs' classes."
      ]
    },
    {
      "cell_type": "code",
      "metadata": {
        "id": "8e6a95c2",
        "colab": {
          "base_uri": "https://localhost:8080/",
          "height": 759
        },
        "outputId": "bc6154f3-b61c-43ce-f1a7-1d67e0d24191"
      },
      "source": [
        "import pandas as pd\n",
        "\n",
        "# Load the player performance matrix\n",
        "performance_df = pd.read_csv('player_performance_matrix.csv').set_index('player')\n",
        "\n",
        "# Filter for batters (players with at least one batting inning)\n",
        "batters_df = performance_df[performance_df['innings'] >= 15].copy()\n",
        "\n",
        "# Rank batters based on the specified parameters (higher is better for all)\n",
        "batters_df['avg_rank'] = batters_df['average'].rank(ascending=False, method='min')\n",
        "batters_df['sr_rank'] = batters_df['strike_rate'].rank(ascending=False, method='min')\n",
        "batters_df['innings_rank'] = batters_df['innings'].rank(ascending=False, method='min')\n",
        "batters_df['hundreds_rank'] = batters_df['hundreds'].rank(ascending=False, method='min')\n",
        "batters_df['fifties_rank'] = batters_df['fifties'].rank(ascending=False, method='min')\n",
        "\n",
        "\n",
        "# Define quantile boundaries for batting average\n",
        "# Using 5 quantiles for 5 classes (0-20%, 20-40%, 40-60%, 60-80%, 80-100%)\n",
        "# `pd.qcut` is perfect for this, but if there are too few unique values, `cut` with custom bins is better.\n",
        "# Given a small dataset of 4 players, direct manual bins or checking unique counts is safer.\n",
        "if batters_df['average'].nunique() < 5:\n",
        "    # Fallback for very small number of unique averages\n",
        "    # For this specific 4-player dataset, let's use equal counts for now.\n",
        "    # For demonstration, assign based on sorted order.\n",
        "    # Using index as the player identifier directly\n",
        "    sorted_averages = batters_df['average'].sort_values().index.tolist()\n",
        "    # Simple classification for 4 players, could be more sophisticated for larger sets\n",
        "    batter_class_map = {\n",
        "        sorted_averages[0]: 'Class 1',\n",
        "        sorted_averages[1]: 'Class 2',\n",
        "        sorted_averages[2]: 'Class 3',\n",
        "        sorted_averages[3]: 'Class 4'\n",
        "    }\n",
        "    batters_df['Runs_Class'] = [batter_class_map.get(player_idx, 'N/A') + f' (Avg: {batters_df.loc[player_idx][\"average\"]:.2f})' for player_idx in batters_df.index]\n",
        "\n",
        "else:\n",
        "    # This block would be for a larger dataset where quantiles make more sense\n",
        "    batters_df['Runs_Class'] = pd.qcut(\n",
        "        batters_df['average'],\n",
        "        q=5, # 5 classes\n",
        "        labels=[\n",
        "            'Class 1 (Avg: Bottom 20%)',\n",
        "            'Class 2 (Avg: 20-40%)',\n",
