      "source": [
        "### Bowlers Ranking and Classification\n",
        "\n",
        "Next, I'll filter for players who have bowled, rank them by Innings Bowled, Overs Bowled, Bowling Average, and Bowling Strike Rate, and categorize them into 'Wickets' classes."
      ]
    },
    {
      "cell_type": "code",
      "metadata": {
        "id": "0d2b5b2f",
        "colab": {
          "base_uri": "https://localhost:8080/",
          "height": 515
        },
        "outputId": "b836362f-970d-4c6b-e39a-ba4edafb8a0f"
      },
      "source": [
        "import pandas as pd\n",
        "\n",
        "# Load the player performance matrix\n",
        "performance_df = pd.read_csv('player_performance_matrix.csv').set_index('player')\n",
        "\n",
        "# Filter for bowlers (players with at least one bowling inning)\n",
        "bowlers_df = performance_df[performance_df['bowl_innings'] >= 15].copy()\n",
        "\n",
        "# Calculate wickets per match\n",
        "bowlers_df['wickets_per_match'] = bowlers_df['wickets'] / bowlers_df['bowl_innings']\n",
        "\n",
        "# Rank bowlers based on the specified parameters\n",
        "# For economy, bowl_average, bowl_strike_rate, lower is better (ascending=True)\n",
        "bowlers_df['bowl_innings_rank'] = bowlers_df['bowl_innings'].rank(ascending=False, method='min')\n",
        "bowlers_df['overs_rank'] = bowlers_df['overs'].rank(ascending=False, method='min')\n",
        "bowlers_df['bowl_avg_rank'] = bowlers_df['bowl_average'].rank(ascending=True, method='min')\n",
        "bowlers_df['bowl_sr_rank'] = bowlers_df['bowl_strike_rate'].rank(ascending=True, method='min')\n",
        "\n",
        "\n",
        "# Define quantile boundaries for wickets per match\n",
        "# Using 4 quantiles for 4 classes (0-25%, 25-50%, 50-75%, 75-100%)\n",
        "if bowlers_df['wickets_per_match'].nunique() < 4:\n",
        "    # Fallback for very small number of unique wickets_per_match\n",
        "    # For demonstration, assign based on sorted order for this 2-player dataset.\n",
        "    # Using index as the player identifier directly\n",
        "    sorted_wpm = bowlers_df['wickets_per_match'].sort_values().index.tolist()\n",
        "    bowler_class_map = {\n",
        "        sorted_wpm[0]: 'Class 1',\n",
        "        sorted_wpm[1]: 'Class 2'\n",
        "    }\n",
        "    bowlers_df['Wickets_Class'] = [bowler_class_map.get(player_idx, 'N/A') + f' (WPM: {bowlers_df.loc[player_idx][\"wickets_per_match\"]:.2f})' for player_idx in bowlers_df.index]\n",
        "\n",
        "else:\n",
        "    bowlers_df['Wickets_Class'] = pd.qcut(\n",
        "        bowlers_df['wickets_per_match'],\n",
        "        q=4, # 4 classes\n",
        "        labels=[\n",
        "            'Class 1 (WPM: Bottom 25%)',\n",
        "            'Class 2 (WPM: 25-50%)',\n",
        "            'Class 3 (WPM: 50-75%)',\n",
        "            'Class 4 (WPM: Top 25%)'\n",
        "        ],\n",
        "        duplicates='drop' # Handle cases where quantile bins might be identical\n",
        "    ).astype(str) + ' (WPM: ' + bowlers_df['wickets_per_match'].round(2).astype(str) + ')' # Add actual WPM\n",
        "\n",
        "print(\"Bowlers Ranking and Classification (Quantile-based):\")\n",
        "display(bowlers_df[['bowl_innings', 'overs', 'wickets', 'wickets_per_match', 'economy', 'bowl_average', 'bowl_strike_rate',\n",
